{
  "name": "@agntn/hashes",
  "version": "0.7.2",
  "description": "Hash, HMAC and key derivation algorithms for agents",
  "keywords": [
    "omp-extension",
    "pi-package"
  ],
  "homepage": "https://hashes.agntn.dev",
  "bugs": "https://github.com/agntn/hashes/issues",
  "license": "MIT",
  "author": "oritwoen (https://github.com/oritwoen)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agntn/hashes.git"
  },
  "bin": {
    "hashes": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "extensions/omp",
    "extensions/pi"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./ai": {
      "types": "./dist/ai.d.mts",
      "import": "./dist/ai.mjs"
    },
    "./mcp": {
      "types": "./dist/mcp.d.mts",
      "import": "./dist/mcp.mjs"
    },
    "./sha1": {
      "types": "./dist/sha1.d.mts",
      "import": "./dist/sha1.mjs"
    },
    "./md5": {
      "types": "./dist/md5.d.mts",
      "import": "./dist/md5.mjs"
    },
    "./sha2": {
      "types": "./dist/sha2.d.mts",
      "import": "./dist/sha2.mjs"
    },
    "./ripemd160": {
      "types": "./dist/ripemd160.d.mts",
      "import": "./dist/ripemd160.mjs"
    },
    "./keccak": {
      "types": "./dist/keccak.d.mts",
      "import": "./dist/keccak.mjs"
    },
    "./blake2b": {
      "types": "./dist/blake2b.d.mts",
      "import": "./dist/blake2b.mjs"
    },
    "./blake256": {
      "types": "./dist/blake256.d.mts",
      "import": "./dist/blake256.mjs"
    },
    "./crc": {
      "types": "./dist/crc.d.mts",
      "import": "./dist/crc.mjs"
    },
    "./adler32": {
      "types": "./dist/adler32.d.mts",
      "import": "./dist/adler32.mjs"
    },
    "./xxhash": {
      "types": "./dist/xxhash.d.mts",
      "import": "./dist/xxhash.mjs"
    },
    "./hmac": {
      "types": "./dist/hmac.d.mts",
      "import": "./dist/hmac.mjs"
    },
    "./evp": {
      "types": "./dist/evp.d.mts",
      "import": "./dist/evp.mjs"
    },
    "./scrypt": {
      "types": "./dist/scrypt.d.mts",
      "import": "./dist/scrypt.mjs"
    },
    "./argon2": {
      "types": "./dist/argon2.d.mts",
      "import": "./dist/argon2.mjs"
    },
    "./bcrypt": {
      "types": "./dist/bcrypt.d.mts",
      "import": "./dist/bcrypt.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "obuild",
    "dev": "obuild --stub",
    "docs": "pnpm --filter docs dev",
    "docs:build": "pnpm --filter docs build",
    "fmt": "pnpm build && vp lint --fix && vp fmt",
    "lint": "pnpm build && vp lint && vp fmt --check",
    "typecheck": "tsc --noEmit && pnpm build && tsc -p tsconfig.extensions.json && tsc -p test/tsconfig.json",
    "test": "vp test run",
    "test:watch": "vp test watch",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@agntn/tools": "catalog:deps",
    "@modelcontextprotocol/server": "catalog:deps"
  },
  "devDependencies": {
    "@agntn/ox": "catalog:dev",
    "@earendil-works/pi-coding-agent": "catalog:dev",
    "@modelcontextprotocol/client": "catalog:dev",
    "@modelcontextprotocol/sdk": "catalog:deps",
    "@oh-my-pi/omptype": "catalog:dev",
    "@oh-my-pi/pi-coding-agent": "catalog:dev",
    "@types/node": "catalog:dev",
    "ai": "catalog:dev",
    "esbuild": "catalog:dev",
    "obuild": "catalog:dev",
    "oxlint-tsgolint": "catalog:dev",
    "typebox": "catalog:dev",
    "typescript": "catalog:dev",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.2 <2",
    "@oh-my-pi/pi-coding-agent": ">=18.0.0 <19",
    "ai": ">=7.0.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    },
    "ai": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@11.26.0",
  "omp": {
    "extensions": [
      "./extensions/omp/hashes.ts"
    ]
  },
  "pi": {
    "extensions": [
      "./extensions/pi/hashes.ts"
    ]
  }
}
