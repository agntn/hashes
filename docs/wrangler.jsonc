{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agntn-hashes",
  "account_id": "6ef8d3cbe19975e93d994f25228488e7",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "NUXT_SITE_URL": "https://hashes.agntn.dev"
  },
  "workers_dev": true,
  "preview_urls": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agntn-hashes",
      "database_id": "c0575cb0-c597-498d-87e4-b3f4bb47638a"
    }
  ],
  "routes": [{ "pattern": "hashes.agntn.dev", "custom_domain": true }],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
